# =============================================================================
# ClipForge AI — Environment Configuration
# Copy this file to `.env` and adjust values for your environment.
# =============================================================================

# ------------------------- Core -------------------------
APP_NAME=ClipForge AI
APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=true
APP_URL=http://localhost
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ------------------------- Security -------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
JWT_SECRET=change-me-jwt-secret-also-rotate-regularly
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------- Demo Mode -------------------------
# When true, AI features use local mock provider so the app works without API keys.
DEMO_MODE=true
DEMO_PROGRESS_MIN_MS=400
DEMO_PROGRESS_MAX_MS=1200

# ------------------------- Database -------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clipforge
POSTGRES_USER=clipforge
POSTGRES_PASSWORD=clipforge_dev_password
DATABASE_URL=postgresql+asyncpg://clipforge:clipforge_dev_password@postgres:5432/clipforge

# ------------------------- Redis -------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------- Storage -------------------------
STORAGE_BACKEND=local        # local | s3 | minio | r2
STORAGE_LOCAL_ROOT=/app/data
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media

# S3 (used when STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=clipforge
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# MinIO (used when STORAGE_BACKEND=minio)
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=clipforge
MINIO_SECURE=false

# Cloudflare R2 (used when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=clipforge

# ------------------------- Uploads -------------------------
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_MIME=video/mp4,video/quicktime,video/x-matroska,video/webm
ALLOWED_VIDEO_EXT=mp4,mov,mkv,webm

# ------------------------- AI Providers -------------------------
# Choose provider: openai | anthropic | gemini | openrouter | local | demo
AI_PROVIDER=demo
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# API keys are optional when DEMO_MODE=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ------------------------- Transcription -------------------------
# Choose provider: whisper | whisperx | demo
TRANSCRIPTION_PROVIDER=demo
WHISPER_MODEL=base           # tiny | base | small | medium | large
WHISPER_DEVICE=cpu           # cpu | cuda
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=

# ------------------------- Video Processing -------------------------
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
VIDEO_THREADS=4
DEFAULT_EXPORT_CODEC=libx264
DEFAULT_EXPORT_PRESET=medium
DEFAULT_EXPORT_CRF=23

# ------------------------- CORS -------------------------
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8000

# ------------------------- Rate Limiting -------------------------
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_HOUR=20

# ------------------------- Observability -------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json               # json | text
SENTRY_DSN=

# ------------------------- Admin bootstrap -------------------------
ADMIN_EMAIL=admin@clipforge.local
ADMIN_PASSWORD=admin_change_me
ADMIN_NAME=Administrator
